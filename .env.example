# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Backend ───────────────────────────────────────────────────────────────────
# Set to "true" to skip real Anthropic calls and use a local mock streamer
USE_MOCK_AI=false
DATABASE_URL=sqlite:////data/db.sqlite3

# Allowed CORS origins (comma-separated). Set your production frontend URL (e.g. Vercel) here
CORS_ORIGINS=http://localhost:5173

# Optional port override for production container (Render sets $PORT automatically)
PORT=8000

# ── Frontend (picked up by Vite via VITE_ prefix) ────────────────────────────
VITE_API_URL=http://localhost:8000
