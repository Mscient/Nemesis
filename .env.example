# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://stocksense:stocksense@db:5432/stocksense
# For local SQLite dev: DATABASE_URL=sqlite+aiosqlite:///./stocksense.db

# ─── AI / LLM ──────────────────────────────────────────────
AI_ENABLED=false
LLM_PROVIDER=mock          # anthropic | openai | mock
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_KEY=

# ─── App ───────────────────────────────────────────────────
MOCK_MODE=false            # true → return example payloads from backend/mocks/
LOG_LEVEL=INFO
